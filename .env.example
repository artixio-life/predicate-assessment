# Shared Postgres — same database as source-predicate (crawler) and
# regulatory-explorer (drug schema owner). Use the same values as those
# repos' .env files.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=quriousri
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Shared MinIO/S3 — same instance source-predicate uploads crawled documents
# to. Use the same values as that repo's .env file.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Stage B: OCR fallback for scanned/low-text-density PDFs.
MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_MAX_CHUNK_BYTES=47185920
# MISTRAL_OCR_TIMEOUT_S=120

# Stage C: AI extraction, via OpenRouter (one key, swappable model).
OPEN_ROUTER_API_KEY=
EXTRACTOR_MODEL=google/gemini-2.5-flash

# Optional: cap how many rows each stage processes per run (unset = no limit).
# PIPELINE_LIMIT=50

# Optional: scope a run to one country (matches drug.regulatory_geography.country_name
# via source.country / drug.products.country_id), e.g. for testing a change against a
# small known slice before running it over everything.
# PIPELINE_COUNTRY=Brazil

# Concurrent claim-loop workers per stage (default 4). Two workers — whether
# threads here or two separate `docker compose` runs — can never claim the
# same row; see processing/claim.py.
PIPELINE_WORKERS=4

# Which stages to run (default: all three, in order).
#   promote -> Stage A, source.drug_predicate_raw_records -> drug.products
#   text    -> Stage B, PDF/OCR text extraction + chunking
#   ai      -> Stage C, the chunk-fold AI extraction
# Set this to stop promoting new raw records and only re-process rows already
# in drug.products:
#   PIPELINE_STAGES=text,ai
# Or run a single stage on its own:
#   PIPELINE_STAGES=ai
# PIPELINE_STAGES=promote,text,ai

# Rows claimed + inserted per round trip in Stage A (default 200).
# PROMOTE_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Self-hosted LLM (processing/llm_service_client.py), used by
# tools/local_llm_harness.py to benchmark a local model against Stage C's real
# workload. Separate from OPEN_ROUTER_API_KEY/EXTRACTOR_MODEL above, which is
# what the live pipeline uses.
LLM_SERVICE_BASE_URL=http://localhost:8000/v1
LLM_SERVICE_API_KEY=
LLM_SERVICE_MODEL=gemma-4-26b
# Context window in tokens. Discovered from GET /models (max_model_len) when the
# server reports it; this is the fallback and the --context-tokens default.
LLM_SERVICE_CONTEXT_TOKENS=22000
LLM_SERVICE_DISCOVERY_CONCURRENCY=8
LLM_SERVICE_TIMEOUT=180
LLM_SERVICE_RETRIES=3

# Fall back to OpenRouter (PAID) when the self-hosted service is unreachable or
# keeps erroring. 'false' makes self-hosted failures fatal instead.
LLM_SERVICE_FALLBACK=true
LLM_FALLBACK_MODEL=google/gemini-2.5-flash
# Consecutive self-hosted failures before the run switches to the fallback.
LLM_SERVICE_FALLBACK_AFTER=2
# ...and how long to stay there before re-probing the self-hosted endpoint. The
# run ALWAYS prefers self-hosted and returns to it as soon as it answers again,
# so an llm-service restart costs one cooldown rather than the whole run. A
# failed probe doubles the wait, up to LLM_SERVICE_RECOVERY_MAX, so a genuinely
# dead endpoint is checked rarely instead of once per product.
LLM_SERVICE_RECOVERY_AFTER=60
LLM_SERVICE_RECOVERY_MAX=900

# Stage C reply cap. The fold re-emits the whole accumulated object each call, so
# this must cover the biggest accumulator (~3,560 tokens observed), not the
# biggest excerpt. Do NOT raise it "for safety": vLLM reserves KV cache for the
# declared value and defers requests it cannot guarantee that space for, so an
# over-large cap silently throttles concurrency (`Deferred: N reqs` in its log).
AI_EXTRACTION_MAX_TOKENS=3072

# Excerpts per fold call. 5 minimises context-overflow splits; 7 costs ~10% fewer
# output tokens (fewer calls = fewer full re-emissions of the accumulator), which
# is the better trade when generation throughput is the bottleneck, as it is on
# the self-hosted GPU. 7 leaves ~3.7k for the accumulator in a 22k window.
AI_EXTRACTION_CHUNKS_PER_CALL=7
